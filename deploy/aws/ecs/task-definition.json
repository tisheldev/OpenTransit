{
  "family": "opentransit-h0",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "ephemeralStorage": {
    "sizeInGiB": 20
  },
  "executionRoleArn": "{{EXECUTION_ROLE_ARN}}",
  "containerDefinitions": [
    {
      "name": "init",
      "image": "{{ECR_REGISTRY}}/opentransit-data@{{DATA_DIGEST}}",
      "essential": false,
      "user": "0",
      "memory": 192,
      "command": [
        "--payload",
        "/payload",
        "--generation-dir",
        "/generation",
        "--uid",
        "10001",
        "--gid",
        "10001",
        "--photon-dir",
        "/photon_data",
        "--writable-dir",
        "/run/opentransit",
        "--writable-dir",
        "/scratch/api",
        "--writable-dir",
        "/scratch/motis",
        "--writable-dir",
        "/scratch/photon"
      ],
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "AUDIT_WRITE",
            "FSETID",
            "KILL",
            "MKNOD",
            "NET_BIND_SERVICE",
            "NET_RAW",
            "SETFCAP",
            "SETGID",
            "SETPCAP",
            "SETUID",
            "SYS_CHROOT"
          ]
        },
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/opentransit/h0",
          "awslogs-region": "il-central-1",
          "awslogs-stream-prefix": "init",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "generation",
          "containerPath": "/generation",
          "readOnly": false
        },
        {
          "sourceVolume": "probe",
          "containerPath": "/run/opentransit",
          "readOnly": false
        },
        {
          "sourceVolume": "tmp-api",
          "containerPath": "/scratch/api",
          "readOnly": false
        },
        {
          "sourceVolume": "tmp-motis",
          "containerPath": "/scratch/motis",
          "readOnly": false
        },
        {
          "sourceVolume": "photon-data",
          "containerPath": "/photon_data",
          "readOnly": false
        },
        {
          "sourceVolume": "tmp-photon",
          "containerPath": "/scratch/photon",
          "readOnly": false
        }
      ],
      "readonlyRootFilesystem": true
    },
    {
      "name": "motis",
      "image": "{{ECR_REGISTRY}}/opentransit-motis@sha256:6055f51eec43eeed28524037ca0161b96efe9cd05728eaa9ac04c20c2826d330",
      "essential": true,
      "user": "10001",
      "memory": 1280,
      "command": [
        "/motis",
        "server",
        "-d",
        "/generation/motis"
      ],
      "dependsOn": [
        {
          "containerName": "init",
          "condition": "SUCCESS"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- 'http://127.0.0.1:8080/api/v6/plan?fromPlace=32.0836,34.7981&toPlace=32.0838,34.8044' >/dev/null 2>&1 || exit 1"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 60
      },
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/opentransit/h0",
          "awslogs-region": "il-central-1",
          "awslogs-stream-prefix": "motis",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "generation",
          "containerPath": "/generation",
          "readOnly": true
        },
        {
          "sourceVolume": "tmp-motis",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "readonlyRootFilesystem": true,
      "startTimeout": 900,
      "stopTimeout": 30
    },
    {
      "name": "photon",
      "image": "{{ECR_REGISTRY}}/opentransit-photon@{{PHOTON_DIGEST}}",
      "essential": true,
      "user": "10001",
      "memory": 768,
      "command": [
        "java",
        "-Xms256m",
        "-Xmx512m",
        "-jar",
        "/opt/photon/photon-1.3.0.jar",
        "-data-dir",
        "/photon_data",
        "serve",
        "-listen-ip",
        "127.0.0.1",
        "-listen-port",
        "2322"
      ],
      "dependsOn": [
        {
          "containerName": "init",
          "condition": "SUCCESS"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:2322/status >/dev/null || exit 1"
        ],
        "interval": 20,
        "timeout": 5,
        "retries": 9,
        "startPeriod": 120
      },
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/opentransit/h0",
          "awslogs-region": "il-central-1",
          "awslogs-stream-prefix": "photon",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "photon-data",
          "containerPath": "/photon_data",
          "readOnly": false
        },
        {
          "sourceVolume": "tmp-photon",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "readonlyRootFilesystem": true,
      "startTimeout": 900,
      "stopTimeout": 30
    },
    {
      "name": "verifier",
      "image": "{{ECR_REGISTRY}}/opentransit-api@{{API_DIGEST}}",
      "essential": false,
      "user": "10001",
      "memory": 192,
      "command": [
        "/app/.venv/bin/opentransit",
        "probe",
        "--generation",
        "/generation",
        "--engine-url",
        "http://127.0.0.1:8080",
        "--queries",
        "/generation/probe-queries.json",
        "--output",
        "/run/opentransit/probe.json"
      ],
      "dependsOn": [
        {
          "containerName": "init",
          "condition": "SUCCESS"
        },
        {
          "containerName": "motis",
          "condition": "HEALTHY"
        }
      ],
      "environment": [
        {
          "name": "PYTHONDONTWRITEBYTECODE",
          "value": "1"
        },
        {
          "name": "TMPDIR",
          "value": "/run/opentransit"
        }
      ],
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/opentransit/h0",
          "awslogs-region": "il-central-1",
          "awslogs-stream-prefix": "verifier",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "generation",
          "containerPath": "/generation",
          "readOnly": true
        },
        {
          "sourceVolume": "probe",
          "containerPath": "/run/opentransit",
          "readOnly": false
        }
      ],
      "readonlyRootFilesystem": true,
      "startTimeout": 600
    },
    {
      "name": "api",
      "image": "{{ECR_REGISTRY}}/opentransit-api@{{API_DIGEST}}",
      "essential": true,
      "user": "10001",
      "memory": 512,
      "command": [
        "/app/.venv/bin/uvicorn",
        "opentransit.api.app:create_app",
        "--factory",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--no-access-log",
        "--log-level",
        "info",
        "--timeout-graceful-shutdown",
        "25"
      ],
      "dependsOn": [
        {
          "containerName": "verifier",
          "condition": "SUCCESS"
        },
        {
          "containerName": "motis",
          "condition": "HEALTHY"
        },
        {
          "containerName": "photon",
          "condition": "HEALTHY"
        }
      ],
      "environment": [
        {
          "name": "OPENTRANSIT_MANIFEST",
          "value": "/generation/manifest.json"
        },
        {
          "name": "OPENTRANSIT_MOTIS_URL",
          "value": "http://127.0.0.1:8080"
        },
        {
          "name": "OPENTRANSIT_PROBE",
          "value": "/run/opentransit/probe.json"
        },
        {
          "name": "OPENTRANSIT_RATE_LIMIT_ENABLED",
          "value": "1"
        },
        {
          "name": "OPENTRANSIT_TRUSTED_PROXIES",
          "value": "{{VPC_CIDR}}"
        },
        {
          "name": "OPENTRANSIT_PHOTON_ADMIN_URL",
          "value": "http://127.0.0.1:9201"
        },
        {
          "name": "OPENTRANSIT_PHOTON_URL",
          "value": "http://127.0.0.1:2322"
        },
        {
          "name": "PYTHONDONTWRITEBYTECODE",
          "value": "1"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "/app/.venv/bin/python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=2)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 300
      },
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/opentransit/h0",
          "awslogs-region": "il-central-1",
          "awslogs-stream-prefix": "api",
          "mode": "non-blocking",
          "max-buffer-size": "4m"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "generation",
          "containerPath": "/generation",
          "readOnly": true
        },
        {
          "sourceVolume": "probe",
          "containerPath": "/run/opentransit",
          "readOnly": true
        },
        {
          "sourceVolume": "tmp-api",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp",
          "name": "api"
        }
      ],
      "readonlyRootFilesystem": true,
      "startTimeout": 900,
      "stopTimeout": 60
    }
  ],
  "volumes": [
    {
      "name": "generation"
    },
    {
      "name": "probe"
    },
    {
      "name": "tmp-api"
    },
    {
      "name": "tmp-motis"
    },
    {
      "name": "photon-data"
    },
    {
      "name": "tmp-photon"
    }
  ],
  "tags": [
    {
      "key": "project",
      "value": "opentransit"
    },
    {
      "key": "purpose",
      "value": "h0-draft"
    }
  ]
}
