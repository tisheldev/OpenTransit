cted: raise RuntimeError('graph artifact inventory differs from sealed manifest')\ntree=hashlib.sha256()\nfor item in actual: tree.update(f\"{item['path']}\\0{item['bytes']}\\0{item['sha256']}\\n\".encode())\nif tree.hexdigest()!=artifacts['motis']['sha256']: raise RuntimeError('graph tree hash differs from manifest')\nfor base, dirs, files in os.walk(generation, followlinks=False):\n    for name in dirs:\n        if stat.S_IMODE((Path(base)/name).stat().st_mode)&0o005 != 0o005: raise RuntimeError(f'directory unreadable by uid 10001: {name}')\n    for name in files:\n        if stat.S_IMODE((Path(base)/name).stat().st_mode)&0o004 != 0o004: raise RuntimeError(f'file unreadable by uid 10001: {name}')\nprint(json.dumps({'state':'verified','generationId':manifest['generationId'],'referenceSha256':ref_hash,'contentSha256':artifacts['reference']['contentSha256'],'configSha256':config_hash,'graphTreeSha256':tree.hexdigest(),'fileCount':len(staged_inventory),'totalBytes':sum(row['bytes'] for row in staged_inventory.values()),'copiedByteHashesMatch':True,'uid10001Readable':True,'mountPath':'/generation'},sort_keys=True))\nPY"
