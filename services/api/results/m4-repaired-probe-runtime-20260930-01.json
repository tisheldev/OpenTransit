        "Cmd": [
          "-ec",
          "set -eu\ncp -a /source/. /generation/\nfind /generation -type d -exec chmod a+rx {} +\nfind /generation -type f -exec chmod a+r {} +\npython - <<'PY'\nimport hashlib, json, os, stat, sys\nfrom pathlib import Path\nfrom opentransit.core.artifacts import verify_artifacts\nsource=Path('/source'); generation=Path('/generation')\ndef inventory(root):\n    values={}\n    for base, dirs, files in os.walk(root, followlinks=False):\n        for name in dirs+files:\n            path=Path(base)/name\n            if path.is_symlink():\n                raise RuntimeError(f'symlink is forbidden: {path.relative_to(root)}')\n        for name in files:\n            path=Path(base)/name\n            digest=hashlib.sha256()\n            with path.open('rb') as stream:\n                for block in iter(lambda:stream.read(1024*1024),b''):\n                    digest.update(block)\n            values[path.relative_to(root).as_posix()]={'bytes':path.stat().st_size,'sha256':digest.hexdigest()}\n    return values\nsrc_inventory=inventory(source); dst_inventory=inventory(generation)\nif src_inventory != dst_inventory:\n    raise RuntimeError('copied file inventory or byte hashes differ from source')\nmanifest=json.loads((generation/'manifest.json').read_text(encoding='utf-8'))\nif manifest.get('state')!='ready' or manifest.get('generationId')!='c7b66eee1ad04dddba13f4c5dade5ef2023963a1ac0384857aaf173b9d164aa1':\n    raise RuntimeError('copied manifest is not the expected ready generation')\nverified=verify_artifacts(generation, manifest)\nif verified.get('generationId')!=manifest['generationId'] or verified.get('referenceSha256')!=manifest['artifacts']['reference']['sha256']:\n    raise RuntimeError('native-volume artifact verification differs from sealed manifest')\nfor base, dirs, files in os.walk(generation, followlinks=False):\n    for name in dirs:\n        if stat.S_IMODE((Path(base)/name).stat().st_mode)&0o005 != 0o005:\n            raise RuntimeError(f'directory not traversable by uid 10001: {Path(base)/name}')\n    for name in files:\n        if stat.S_IMODE((Path(base)/name).stat().st_mode)&0o004 != 0o004:\n            raise RuntimeError(f'file not readable by uid 10001: {Path(base)/name}')\nprint(json.dumps({'state':'verified','generationId':manifest['generationId'],'referenceSha256':verified['referenceSha256'],'contentSha256':manifest['artifacts']['reference']['contentSha256'],'configSha256':verified['configSha256'],'graphTreeSha256':verified['graphTreeSha256'],'fileCount':len(dst_inventory),'totalBytes':sum(item['bytes'] for item in dst_inventory.values()),'copiedByteHashesMatch':True,'uid10001Readable':True,'mountPath':'/generation'},sort_keys=True))\nPY"
        ],
